  <div class="nav-links">
    <a href="/" data-zh="首页" data-en="Home">首页</a>
    <a href="/blog/" data-zh="博客" data-en="Blog">博客</a>
    <a href="/archives/" data-zh="归档" data-en="Archives">归档</a>
