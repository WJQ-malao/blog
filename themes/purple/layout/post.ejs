<article class="card post-full">
  <h1 class="post-title"><%= page.title %></h1>
  <div class="meta">
    <span><%= date(page.date, 'YYYY-MM-DD') %></span>
    <% if (page.categories && page.categories.length) { %>
      <span class="dot">·</span>
      <% page.categories.each(function (c) { %>
        <a class="cat" href="<%- url_for(c.path) %>"><%= c.name %></a>
      <% }) %>
    <% } %>
    <% if (page.tags && page.tags.length) { %>
      <% page.tags.each(function (t) { %>
        <a class="tag" href="<%- url_for(t.path) %>">#<%= t.name %></a>
      <% }) %>
    <% } %>
  </div>
  <div class="content">
    <%- page.content %>
  </div>
</article>

<div class="card comments">
  <script src="https://giscus.app/client.js"
    data-repo="WJQ-malao/blog"
    data-repo-id="R_kgDOU9uiDg"
    data-category="General"
    data-category-id="DIC_kwDOU9uiDs4DH_w7"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="preferred_color_scheme"
    data-lang="zh-CN"
    crossorigin="anonymous"
    async>
  </script>
</div>

<nav class="post-nav">
  <a class="card pager-btn" href="/blog/" data-zh="← 返回博客列表" data-en="← Back to Blog">← 返回博客列表</a>
</nav>

<script>
// 文章页交互：图片灯箱 + 点击空白返回博客列表
document.body.classList.add('post-page');
var lb = null;
function closeLb() {
  if (lb) { lb.remove(); lb = null; document.body.style.overflow = ''; }
}
document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape') closeLb();
});
document.addEventListener('click', function (e) {
  // 灯箱打开时：任何点击只负责关闭灯箱，不触发返回
  if (lb) { closeLb(); return; }
  // 点击文章内图片：打开灯箱
  var img = e.target.closest('.content img');
  if (img) {
    lb = document.createElement('div');
    lb.className = 'lightbox-overlay';
    lb.appendChild(img.cloneNode());
    document.body.appendChild(lb);
    document.body.style.overflow = 'hidden';
    return;
  }
  // 点击正文外空白：返回博客列表
  var t = e.target;
  if (t === document.body || (t.classList && t.classList.contains('container'))) {
    window.location.href = '/blog/';
  }
});
</script>
